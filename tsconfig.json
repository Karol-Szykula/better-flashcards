{ 
  "compilerOptions": {
    "strict": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "target": "es2018",
    "skipLibCheck": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "obsidian-test-mocks/obsidian": [
        "./node_modules/obsidian-test-mocks/dist/lib/cjs/obsidian/index.d.cts"
      ]
    },
    "allowJs": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "lib": [
      "dom",
      "es2018",
      "scripthost",
      "ES2020.String"

    ],
  },
  "include": [
    "**/*.ts", "**/*.tsx", "jest.config.js",
  ]
}
