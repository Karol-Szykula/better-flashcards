{ 
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2018",
    "skipLibCheck": true,
    "types": [
      "jest",
      "node"
    ],
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "downlevelIteration": true,
    "lib": [
      "dom",
      "es2018",
      "scripthost",
      "ES2020.String"

    ],
  },
  "include": [
    "**/*.ts", "jest.config.js",
  ]
}