{
  "name": "flashcards",
  "version": "0.2.1",
  "description": "An Anki integration.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "esbuild main.ts --bundle --external:obsidian --format=cjs --platform=browser --target=es2018 --outfile=main.js --sourcemap=inline",
    "release": "npm run build && mkdir -p dist/better-flashcards && cp main.js manifest.json styles.css dist/better-flashcards/",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "jscpd": "jscpd src --threshold 3",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid --output-to docs/architecture.md",
    "depcruise:archi": "depcruise src --config .dependency-cruiser.cjs --output-type archi",
    "format": "prettier --write .",
    "doc:sync-table": "esbuild src/dev/print-sync-decision-table.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/sync-decision-table.cjs --log-level=error && node node_modules/.cache/sync-decision-table.cjs",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test && pnpm run jscpd && pnpm run depcruise",
    "precommit": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip"
  },
  "keywords": [
    "obsidian",
    "anki",
    "flashcards"
  ],
  "author": "Mihir Patel, Karol Szyku\u0142a",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "dependency-cruiser": "^18.3.1",
    "esbuild": "0.28.1",
    "eslint": "10.9.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "16.5.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "^30.5.1",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "obsidian": "https://github.com/obsidianmd/obsidian-api/tarball/master",
    "obsidian-test-mocks": "5.1.0",
    "prettier": "^3.9.8",
    "rollup": "4.62.4",
    "ts-jest": "29.4.12",
    "tslib": "2.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@types/showdown": "1.9.3",
    "@xstate/graph": "^3.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "showdown": "1.9.1",
    "xstate": "^5.33.1"
  }
}
